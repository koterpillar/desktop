{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "nl *": "allow",
      "pwd": "allow",
      "printf *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "sed -n *": "allow",
      "tail *": "allow",
      "true": "allow",
      "wc *": "allow",
      "xargs cat": "allow",
      "xargs grep *": "allow",

      "identify *": "allow",

      "git add *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git log *": "allow",
      "git range-diff *": "allow",
      "git remote show *": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",

      "gh pr checks *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",

      "node --run build *": "allow",
      "node --run lint *": "allow",
      "node --run prettier *": "allow",
      "node --run test *": "allow",
      "node --run typecheck *": "allow",
      "npm view *": "allow",
      "npx prettier *": "allow",
      "yarn build *": "allow",
      "yarn eslint *": "allow",
      "yarn info *": "allow",
      "yarn install": "allow",
      "yarn jest *": "allow",
      "yarn lint": "allow",
      "yarn lint *": "allow",
      "yarn list *": "allow",
      "yarn prettier *": "allow",
      "yarn test *": "allow",
      "yarn tsc *": "allow",
      "yarn typecheck *": "allow",
      "yarn vitest *": "allow",
      "yarn why *": "allow",

      "stack build *": "allow",
      "stack test *": "allow",

      "./gradlew --dependencyInsight *": "allow",

      "cargo clippy *": "allow",
      "cargo deny check *": "allow",
      "cargo doc *": "allow",
      "cargo fmt *": "allow",

      "./bin/lint *": "allow",
      "make test": "allow",
      "ssh-add -l": "allow",
    }
  },
  "mcp": {
    "Home Assistant": {
      "type": "remote",
      "url": "https://home.koterpillar.com/api/mcp",
      "oauth": {}
    }
  }
}
