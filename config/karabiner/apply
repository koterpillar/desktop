#!/bin/bash

set -euo pipefail

# find where this script is
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

DRY_RUN=false
case "${1:-}" in
    -n|--dry-run) DRY_RUN=true ;;
    "") ;;
    *) echo "usage: $(basename "$0") [-n|--dry-run]" >&2; exit 2 ;;
esac

if $DRY_RUN; then
    # Compile only: karabiner.json is live config, so don't touch it
    dhall-to-json < "${SCRIPT_DIR}/karabiner.dhall" > /dev/null
    echo "karabiner.dhall compiles OK (nothing written)"
else
    # Compile to a temporary file first: redirecting straight into the live
    # config leaves it empty when the dhall prelude fetch fails
    TMP=$(mktemp)
    trap 'rm -f "$TMP"' EXIT
    dhall-to-json < "${SCRIPT_DIR}/karabiner.dhall" > "$TMP"
    mv "$TMP" "${SCRIPT_DIR}/karabiner.json"
fi
